local function getDescriptionAssetIds(value)
    local ids = {}
    if type(value) == "number" then
        if value > 0 then table.insert(ids, value) end
        return ids
    end
    if type(value) ~= "string" then return ids end
    for id in string.gmatch(value, "%d+") do
        local numericId = tonumber(id)
        if numericId and numericId > 0 then
            table.insert(ids, numericId)
        end
    end
    return ids
end

local function getAvatarAssetType(name)
    local ok, value = pcall(function()
        return Enum.AvatarAssetType[name]
    end)
    return ok and value or name
end

local function getAvatarAccessoryType(name)
    local ok, value = pcall(function()
        return Enum.AccessoryType[name]
    end)
    return ok and value or Enum.AccessoryType.Hat
end

local function registerCurrentFitItem(assetId, definition)
    local key = definition.property .. ":" .. tostring(assetId)
    if CurrentFitKeys[key] then return end
    CurrentFitKeys[key] = true

    local item = ITEM_BY_ID[assetId]
    if not item then
        item = registerItem({
            name = "AvatarFit_" .. definition.property .. "_" .. tostring(assetId),
            label = definition.label,
            id = assetId,
            assetType = getAvatarAssetType(definition.assetTypeName),
            accessoryType = definition.accessoryTypeName and getAvatarAccessoryType(definition.accessoryTypeName) or nil,
            kind = definition.kind,
            property = definition.property,
            searchCategory = "All",
        })
    end

    item.kind = definition.kind or (definition.accessoryTypeName and nil or "catalog")
    item.property = definition.property
    if PendingAccessories._Disabled[item.name] then return end
    Enabled[item.name] = true
    if createCatalogButton then
        createCatalogButton(item, #ITEMS)
    end
    refreshToggle(item.name)
    if createSelectorOption then
        createSelectorOption(item, #ITEMS)
    end
    table.insert(CurrentFitItems, {
        itemName = item.name,
        assetId = assetId,
        label = item.label,
        property = definition.property,
        assetTypeName = definition.assetTypeName,
    })
end

local function renderCurrentFit()
    for _, child in ipairs(CurrentFitList:GetChildren()) do
        if child ~= CurrentFitLayout then
            child:Destroy()
        end
    end

    if #CurrentFitItems == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -4, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = tr(
            "No se pudieron leer los artículos del fit actual.",
            "The current fit items could not be read."
        )
        empty.TextColor3 = COLORS.Muted
        empty.TextSize = 9
        empty.Font = Enum.Font.Gotham
        empty.TextWrapped = true
        empty.Parent = CurrentFitList
        return
    end

    for index, entry in ipairs(CurrentFitItems) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 42)
        row.LayoutOrder = index
        row.BackgroundColor3 = COLORS.Card
        row.Parent = CurrentFitList
        corner(row, 8)
        stroke(row, COLORS.CardHover, 1)

        local thumbnail = Instance.new("ImageLabel")
        thumbnail.Size = UDim2.fromOffset(34, 34)
        thumbnail.Position = UDim2.fromOffset(5, 4)
        thumbnail.BackgroundColor3 = COLORS.CardHover
        thumbnail.BackgroundTransparency = 0.15
        thumbnail.Image = "rbxthumb://type=Asset&id=" .. tostring(entry.assetId) .. "&w=100&h=100"
        thumbnail.ScaleType = Enum.ScaleType.Fit
        thumbnail.Parent = row
        corner(thumbnail, 6)

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -150, 1, 0)
        nameLabel.Position = UDim2.fromOffset(48, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = entry.label
        nameLabel.TextColor3 = COLORS.Text
        nameLabel.TextSize = 9
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.Parent = row

        local removeButton = Instance.new("TextButton")
        removeButton.Size = UDim2.fromOffset(86, 26)
        removeButton.Position = UDim2.new(1, -94, 0.5, -13)
        removeButton.BackgroundColor3 = COLORS.Danger
        removeButton.Text = tr("QUITAR", "REMOVE")
        removeButton.TextColor3 = COLORS.Text
        removeButton.TextSize = 9
        removeButton.Font = Enum.Font.GothamBold
        removeButton.Parent = row
        corner(removeButton, 6)

        removeButton.MouseButton1Click:Connect(function()
            local item = ITEM_BY_NAME[entry.itemName]
            if item and Enabled[item.name] then
                toggleItem(item.name, false)
            end
            PreviewDirty = true
            for itemIndex, currentEntry in ipairs(CurrentFitItems) do
                if currentEntry == entry then
                    table.remove(CurrentFitItems, itemIndex)
                    break
                end
            end
            CurrentFitKeys[entry.property .. ":" .. tostring(entry.assetId)] = nil
            renderCurrentFit()
            AvatarStatus.Text = entry.label .. "  •  " .. tr("retirado", "removed")
            AvatarStatus.TextColor3 = COLORS.Muted
        end)
    end
end

local function loadCurrentFit()
    table.clear(CurrentFitItems)
    table.clear(CurrentFitKeys)

    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local description
    if humanoid then
        pcall(function()
            description = humanoid:GetAppliedDescription()
        end)
    end

    if description then
        for _, definition in ipairs(CurrentFitDefinitions) do
            local ok, value = pcall(function()
                return description[definition.property]
            end)
            if ok then
                for _, assetId in ipairs(getDescriptionAssetIds(value)) do
                    registerCurrentFitItem(assetId, definition)
                end
            end
        end
    end

    for _, item in ipairs(ITEMS) do
        if Enabled[item.name] then
            local alreadyListed = false
            for _, entry in ipairs(CurrentFitItems) do
                if entry.itemName == item.name then
                    alreadyListed = true
                    break
                end
            end
            if not alreadyListed then
                table.insert(CurrentFitItems, {
                    itemName = item.name,
                    assetId = item.id,
                    label = item.label,
                    property = item.property or item.name,
                })
            end
        end
    end

    renderCurrentFit()
    for _, entry in ipairs(CurrentFitItems) do
        task.spawn(function()
            local ok, info = pcall(function()
                return S.MarketplaceService:GetProductInfo(entry.assetId, Enum.InfoType.Asset)
            end)
            if ok and info and info.Name then
                 entry.label = tostring(info.Name)
                renderCurrentFit()
            end
        end)
    end
end

local function syncCurrentFitFromEnabled()
    table.clear(CurrentFitItems)
    table.clear(CurrentFitKeys)
    for _, item in ipairs(ITEMS) do
        if Enabled[item.name] then
            local key = (item.property or item.name) .. ":" .. tostring(item.id)
            if not CurrentFitKeys[key] then
                CurrentFitKeys[key] = true
                table.insert(CurrentFitItems, {
                    itemName = item.name,
                    assetId = item.id,
                    label = item.label,
                    property = item.property or item.name,
                })
            end
        end
    end
    renderCurrentFit()
end

local function renderSavedFits()
    for _, child in ipairs(FitList:GetChildren()) do
        if child ~= FitListLayout then
            child:Destroy()
        end
    end
    table.clear(FitRows)

    for index, fit in ipairs(SavedFits) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.LayoutOrder = index
        row.BackgroundColor3 = COLORS.Card
        row.Parent = FitList
        corner(row, 8)
        stroke(row, COLORS.CardHover, 1)

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -190, 1, 0)
        nameLabel.Position = UDim2.fromOffset(10, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = fit.name
        nameLabel.TextColor3 = COLORS.Text
        nameLabel.TextSize = 10
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = row

        local equipButton = Instance.new("TextButton")
        equipButton.Size = UDim2.fromOffset(78, 26)
        equipButton.Position = UDim2.new(1, -168, 0.5, -13)
        equipButton.BackgroundColor3 = COLORS.AccentDark
        equipButton.Text = tr("EQUIPAR", "EQUIP")
        equipButton.TextColor3 = COLORS.Text
        equipButton.TextSize = 9
        equipButton.Font = Enum.Font.GothamBold
        equipButton.Parent = row
        corner(equipButton, 6)

        local deleteButton = Instance.new("TextButton")
        deleteButton.Size = UDim2.fromOffset(78, 26)
        deleteButton.Position = UDim2.new(1, -84, 0.5, -13)
        deleteButton.BackgroundColor3 = COLORS.Danger
        deleteButton.Text = tr("BORRAR", "DELETE")
        deleteButton.TextColor3 = COLORS.Text
        deleteButton.TextSize = 9
        deleteButton.Font = Enum.Font.GothamBold
        deleteButton.Parent = row
        corner(deleteButton, 6)

        equipButton.MouseButton1Click:Connect(function()
            SavedFits._ActiveFit = fit
            clearAvatar()
            task.wait(0.5)
            for itemName, savedItem in pairs(fit.items) do
                local item = ITEM_BY_NAME[itemName]
                if item then
                    if savedItem.transform then
                        Transforms[itemName] = copyTransform(savedItem.transform)
                    end
                    toggleItem(itemName, true)
                    refreshToggle(itemName)
                    task.wait(0.08)
                end
            end
            AvatarStatus.Text = fit.name .. "  •  " .. tr("equipado", "equipped")
            AvatarStatus.TextColor3 = COLORS.Success
            PreviewDirty = true
            syncCurrentFitFromEnabled()
        end)

        deleteButton.MouseButton1Click:Connect(function()
            if SavedFits._ActiveFit == fit then
                SavedFits._ActiveFit = nil
            end
            for savedIndex, savedFit in ipairs(SavedFits) do
                if savedFit == fit then
                    table.remove(SavedFits, savedIndex)
                    break
                end
            end
            renderSavedFits()
            AvatarStatus.Text = tr("Avatar guardado eliminado", "Saved avatar deleted")
            AvatarStatus.TextColor3 = COLORS.Muted
        end)

        table.insert(FitRows, {
            fit = fit,
            nameLabel = nameLabel,
            equipButton = equipButton,
            deleteButton = deleteButton,
        })
    end
end

UnequipAllButton.MouseButton1Click:Connect(function()
    clearAvatar()
    table.clear(CurrentFitItems)
    table.clear(CurrentFitKeys)
    renderCurrentFit()
    AvatarStatus.Text = tr("Accesorios y ropa retirados", "Accessories and clothing removed")
    AvatarStatus.TextColor3 = COLORS.Success
end)

SaveFitButton.MouseButton1Click:Connect(function()
    loadCurrentFit()
    FitNumber += 1
    local fit = captureFit()
    fit.name = "Fit " .. tostring(FitNumber)
    table.insert(SavedFits, fit)
    SavedFits._ActiveFit = fit
    renderSavedFits()
    AvatarStatus.Text = fit.name .. "  •  " .. tr("guardado correctamente", "saved successfully")
    AvatarStatus.TextColor3 = COLORS.Success
end)

renderSavedFits()

