createSelectorOption = function(item, order)
    if item.SelectorCreated then return end
    item.SelectorCreated = true
    local option = Instance.new("TextButton")
    option.Size = UDim2.new(1, 0, 0, 27)
    option.LayoutOrder = order or #ITEMS
    option.BackgroundColor3 = COLORS.Card
    option.Text = item.label
    option.TextColor3 = COLORS.Text
    option.TextSize = 10
    option.Font = Enum.Font.GothamMedium
    option.ZIndex = 21
    option.Parent = SelectorList
    option.MouseButton1Click:Connect(function()
        SelectedItem = item.name
        selectorOpen = false
        SelectorList.Size = UDim2.new(1, -12, 0, 0)
        updateEditor()
    end)
end

