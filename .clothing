local function copyTransform(transform)
    return {
        Scale = transform.Scale,
        PosX = transform.PosX,
        PosY = transform.PosY,
        PosZ = transform.PosZ,
        RotX = transform.RotX,
        RotY = transform.RotY,
        RotZ = transform.RotZ,
    }
end

local function captureFit()
    local fit = {
        items = {},
    }
    for _, item in ipairs(ITEMS) do
        if Enabled[item.name] then
            fit.items[item.name] = {
                transform = copyTransform(Transforms[item.name]),
            }
        end
    end
    return fit
end

local function refreshAllToggles()
    for itemName in pairs(toggleButtons) do
        refreshToggle(itemName)
    end
end

local function clearAvatar()
    local cleared = {}
    for _, entry in ipairs(CurrentFitItems) do
        local item = ITEM_BY_NAME[entry.itemName]
        if item then
            toggleItem(item.name, false)
            cleared[item.name] = true
        end
    end
    for _, item in ipairs(ITEMS) do
        if Enabled[item.name] and not cleared[item.name] then
            toggleItem(item.name, false)
        end
    end

    refreshAllToggles()
    PreviewDirty = true
end

local FitRows = {}
local CurrentFitItems = {}
local CurrentFitKeys = {}
local PreviewWorld = Instance.new("WorldModel")
PreviewWorld.Parent = PreviewViewport
local PreviewCamera = Instance.new("Camera")
PreviewCamera.FieldOfView = 35
PreviewCamera.Parent = PreviewViewport
PreviewViewport.CurrentCamera = PreviewCamera
local PreviewCharacter
local PreviewConnections = {}

PreviewViewport.Active = true
PreviewControls.UpdateCamera = function()
    if not PreviewCharacter then return end
    local size = PreviewControls.BoundsSize
    local focus = Vector3.new(
        PreviewControls.PanX,
        math.max(2, size.Y * 0.48) + PreviewControls.PanY,
        0
    )
    local distance = math.max(5, math.max(size.X, size.Y, size.Z) * 2.2) * PreviewControls.Zoom
    local rotation = CFrame.Angles(PreviewControls.Pitch, PreviewControls.Yaw, 0)
    local offset = rotation:VectorToWorldSpace(Vector3.new(0, 0, distance))
    PreviewCamera.CFrame = CFrame.lookAt(focus + offset, focus)
end

PreviewViewport.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        PreviewControls.DragMode = "rotate"
        PreviewControls.DragInput = input
        PreviewControls.LastPosition = input.Position
    elseif input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3 then
        PreviewControls.DragMode = "pan"
        PreviewControls.DragInput = input
        PreviewControls.LastPosition = input.Position
    elseif input.UserInputType == Enum.UserInputType.Touch then
        PreviewControls.DragMode = "rotate"
        PreviewControls.DragInput = input
        PreviewControls.LastPosition = input.Position
    end
end)

PreviewViewport.InputEnded:Connect(function(input)
    if input == PreviewControls.DragInput
        or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3
        or input.UserInputType == Enum.UserInputType.Touch then
        PreviewControls.DragMode = nil
        PreviewControls.DragInput = nil
        PreviewControls.LastPosition = nil
    end
end)

PreviewViewport.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        PreviewControls.DragInput = input
    end
end)

S.UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        PreviewControls.Zoom = math.clamp(
            PreviewControls.Zoom - input.Position.Z * 0.08,
            0.55,
            1.8
        )
        PreviewControls.UpdateCamera()
        return
    end
    if not PreviewControls.DragMode
        or input ~= PreviewControls.DragInput
        or not PreviewControls.LastPosition then
        return
    end
    local delta = input.Position - PreviewControls.LastPosition
    PreviewControls.LastPosition = input.Position
    if PreviewControls.DragMode == "rotate" then
        PreviewControls.Yaw -= delta.X * 0.01
        PreviewControls.Pitch = math.clamp(PreviewControls.Pitch - delta.Y * 0.01, -0.8, 0.8)
    else
        PreviewControls.PanX = math.clamp(PreviewControls.PanX + delta.X * 0.01, -4, 4)
        PreviewControls.PanY = math.clamp(PreviewControls.PanY - delta.Y * 0.01, -4, 4)
    end
    PreviewControls.UpdateCamera()
end)

makeDraggable(Panel, PreviewViewport, ResizeButton)

local function disconnectPreviewConnections()
    for _, connection in ipairs(PreviewConnections) do
        connection:Disconnect()
    end
    table.clear(PreviewConnections)
end

local function connectPreviewCharacter(character)
    disconnectPreviewConnections()
    if not character then return end
    table.insert(PreviewConnections, character.DescendantAdded:Connect(function()
        PreviewDirty = true
    end))
    table.insert(PreviewConnections, character.DescendantRemoving:Connect(function()
        PreviewDirty = true
    end))
    PreviewDirty = true
end

local function updateAvatarPreview()
    if not PreviewDirty or CurrentTab ~= "Avatar" then return end
    PreviewDirty = false
    PreviewCharacter = nil
    for _, child in ipairs(PreviewWorld:GetChildren()) do
        child:Destroy()
    end

    local character = getCharacter()
    if not character then return end
    local oldArchivable = character.Archivable
    character.Archivable = true
    local ok, clone = pcall(function()
        return character:Clone()
    end)
    character.Archivable = oldArchivable
    if not ok or not clone then return end

    clone.Name = "AvatarPreviewCharacter"
    clone.Parent = PreviewWorld
    PreviewCharacter = clone
    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
        elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
            descendant:Destroy()
        end
    end

    pcall(function()
        clone:PivotTo(CFrame.new())
    end)
    local _, boundsSize = clone:GetBoundingBox()
    PreviewControls.BoundsSize = boundsSize
    PreviewControls.UpdateCamera()
end

