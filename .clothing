local function clearSearchResults()
    for _, child in ipairs(SearchResultsPage:GetChildren()) do
        if child ~= SearchResultsLayout then
            child:Destroy()
        end
    end
end

local function isBundleAccessoryType(assetType)
    local numeric = tonumber(assetType)
    if numeric and table.find({ 8, 41, 42, 43, 44, 45, 46, 47, 76, 77 }, numeric) then
        return true
    end
    local value = string.lower(tostring(assetType or ""))
    return string.find(value, "accessory", 1, true) ~= nil
        or string.find(value, "hair", 1, true) ~= nil
        or string.find(value, "hat", 1, true) ~= nil
        or string.find(value, "face", 1, true) ~= nil
end

showBundleItems = function(data)
    local bundleId = tonumber(data.AssetId or data.BundleId or data.Id)
    if not bundleId then return end

    for _, child in ipairs(BundleItemsPage:GetChildren()) do
        if child ~= BundleItemsLayout then
            child:Destroy()
        end
    end

    BundleTitle.Text = tostring(data.Name or "ITEMS DEL BUNDLE")
    BundleModal.Visible = true

    local loading = Instance.new("TextLabel")
    loading.Size = UDim2.new(1, -8, 0, 34)
    loading.BackgroundTransparency = 1
        loading.Text = tr("CARGANDO ITEMS...", "LOADING ITEMS...")
    loading.TextColor3 = COLORS.Muted
    loading.TextSize = 10
    loading.Font = Enum.Font.GothamBold
    loading.ZIndex = 52
    loading.Parent = BundleItemsPage

    task.spawn(function()
        local ok, info = pcall(function()
                return S.MarketplaceService:GetProductInfo(bundleId, Enum.InfoType.Bundle)
        end)
        if loading.Parent then loading:Destroy() end
        if not ok or not info then
            local errorLabel = Instance.new("TextLabel")
            errorLabel.Size = UDim2.new(1, -8, 0, 40)
            errorLabel.BackgroundTransparency = 1
            errorLabel.Text = tr("No se pudieron cargar los items de este bundle", "Could not load this bundle's items")
            errorLabel.TextColor3 = COLORS.Danger
            errorLabel.TextSize = 10
            errorLabel.Font = Enum.Font.GothamBold
            errorLabel.ZIndex = 52
            errorLabel.Parent = BundleItemsPage
            return
        end

        local bundleItems = info.Items or info.BundleItems or {}
        if #bundleItems == 0 then
            local emptyLabel = Instance.new("TextLabel")
            emptyLabel.Size = UDim2.new(1, -8, 0, 40)
            emptyLabel.BackgroundTransparency = 1
            emptyLabel.Text = tr("Roblox no devolvió items internos para este bundle", "Roblox returned no items for this bundle")
            emptyLabel.TextColor3 = COLORS.Muted
            emptyLabel.TextSize = 10
            emptyLabel.Font = Enum.Font.GothamBold
            emptyLabel.ZIndex = 52
            emptyLabel.Parent = BundleItemsPage
            return
        end

        for index, bundleItem in ipairs(bundleItems) do
            local itemId = tonumber(bundleItem.Id or bundleItem.AssetId)
            local itemName = tostring(bundleItem.Name or ("ITEM " .. tostring(itemId or index)))
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -8, 0, 58)
            row.LayoutOrder = index
            row.BackgroundColor3 = COLORS.Card
            row.ZIndex = 52
            row.Parent = BundleItemsPage
            corner(row, 8)

            if itemId then
                local itemThumbnail = Instance.new("ImageLabel")
                itemThumbnail.Size = UDim2.fromOffset(48, 48)
                itemThumbnail.Position = UDim2.fromOffset(5, 5)
                itemThumbnail.BackgroundColor3 = COLORS.CardHover
                itemThumbnail.Image = "rbxthumb://type=Asset&id=" .. tostring(itemId) .. "&w=420&h=420"
                itemThumbnail.ScaleType = Enum.ScaleType.Fit
                itemThumbnail.ZIndex = 53
                itemThumbnail.Parent = row
                corner(itemThumbnail, 6)
            end

            local itemLabel = Instance.new("TextLabel")
            itemLabel.Size = UDim2.new(1, -154, 1, 0)
            itemLabel.Position = UDim2.fromOffset(64, 0)
            itemLabel.BackgroundTransparency = 1
            itemLabel.Text = itemName .. (itemId and ("  •  ID: " .. tostring(itemId)) or "")
            itemLabel.TextColor3 = COLORS.Text
            itemLabel.TextSize = 10
            itemLabel.Font = Enum.Font.GothamBold
            itemLabel.TextXAlignment = Enum.TextXAlignment.Left
            itemLabel.ZIndex = 53
            itemLabel.Parent = row

            if itemId then
                local bundleUse = Instance.new("TextButton")
                bundleUse.Size = UDim2.fromOffset(78, 24)
                bundleUse.Position = UDim2.new(1, -84, 0.5, -12)
                bundleUse.BackgroundColor3 = COLORS.AccentDark
                bundleUse.Text = tr("USAR", "USE")
                bundleUse.TextColor3 = COLORS.Text
                bundleUse.TextSize = 9
                bundleUse.Font = Enum.Font.GothamBold
                bundleUse.ZIndex = 53
                bundleUse.Parent = row
                corner(bundleUse, 6)
                bundleUse.MouseButton1Click:Connect(function()
                    local catalogItem = ITEM_BY_ID[itemId]
                    if not catalogItem then
                        local bundleAssetType = bundleItem.AssetType or bundleItem.Type or bundleItem.ItemType
                        local bundleKind
                        if not isBundleAccessoryType(bundleAssetType) then
                            bundleKind = "catalog"
                        end
                        catalogItem = registerItem({
                            name = "Bundle_" .. tostring(itemId),
                            label = string.upper(itemName),
                            id = itemId,
                            accessoryType = getSearchAccessoryType(bundleAssetType),
                            assetType = bundleAssetType,
                            kind = bundleKind,
                            searchCategory = SearchCategory,
                            searchData = {
                                AssetId = itemId,
                                AssetType = bundleAssetType,
                                Name = itemName,
                            },
                        })
                        createSelectorOption(catalogItem, #ITEMS)
                    end
                    toggleItem(catalogItem.name, not Enabled[catalogItem.name])
                    bundleUse.Text = Enabled[catalogItem.name] and tr("QUITAR", "REMOVE") or tr("USAR", "USE")
                    bundleUse.BackgroundColor3 = Enabled[catalogItem.name] and COLORS.Success or COLORS.AccentDark
                    SearchStatus.Text = Enabled[catalogItem.name]
                        and (itemName .. " " .. tr("cargado", "loaded"))
                        or (itemName .. " " .. tr("retirado", "removed"))
                    SearchStatus.TextColor3 = Enabled[catalogItem.name] and COLORS.Success or COLORS.Muted
                end)
            end
        end
    end)
end

getSearchAccessoryType = function(assetType)
    local value = string.lower(tostring(assetType or ""))
    local numericNames = {
        [8] = "Hat",
        [41] = "Hair",
        [42] = "Face",
        [43] = "Neck",
        [44] = "Shoulder",
        [45] = "Front",
        [46] = "Back",
        [47] = "Waist",
        [76] = "Eyebrow",
        [77] = "Eyelash",
    }
    local names = {
        hairaccessory = "Hair",
        faceaccessory = "Face",
        neckaccessory = "Neck",
        shoulderaccessory = "Shoulder",
        frontaccessory = "Front",
        backaccessory = "Back",
        waistaccessory = "Waist",
        eyebrowaccessory = "Eyebrow",
        eyelashaccessory = "Eyelash",
        hat = "Hat",
    }
    local numericName = numericNames[tonumber(assetType)]
    if numericName then
        local ok, accessoryType = pcall(function()
            return Enum.AccessoryType[numericName]
        end)
        if ok and accessoryType then return accessoryType end
    end
    for key, enumName in pairs(names) do
        if string.find(value, key, 1, true) then
            local ok, accessoryType = pcall(function()
                return Enum.AccessoryType[enumName]
            end)
            if ok and accessoryType then return accessoryType end
        end
    end
    return Enum.AccessoryType.Hat
end

local function equipFullBundle(data, button)
    local bundleId = tonumber(data.AssetId or data.BundleId or data.Id)
    if not bundleId then return end

    if BundleEnabled[bundleId] then
        for _, itemName in ipairs(BundleItemNames[bundleId] or {}) do
            if Enabled[itemName] then
                toggleItem(itemName, false)
            end
        end
        BundleEnabled[bundleId] = false
        button.Active = true
        button.AutoButtonColor = true
        button.Text = tr("EQUIPAR CUERPO", "EQUIP BODY")
        button.BackgroundColor3 = COLORS.AccentDark
        SearchStatus.Text = tr("Cuerpo retirado", "Body removed")
        SearchStatus.TextColor3 = COLORS.Muted
        return
    end

    button.Active = false
    button.AutoButtonColor = false
    button.Text = "..."

    task.spawn(function()
        local ok, info = pcall(function()
            return S.MarketplaceService:GetProductInfo(bundleId, Enum.InfoType.Bundle)
        end)
        local bundleItems = ok and info and (info.Items or info.BundleItems or {}) or {}
        if not ok or not info or #bundleItems == 0 then
            button.Active = true
            button.AutoButtonColor = true
            button.Text = tr("EQUIPAR CUERPO", "EQUIP BODY")
            SearchStatus.Text = tr(
                "No se pudieron cargar los items del cuerpo",
                "The body items could not be loaded"
            )
            SearchStatus.TextColor3 = COLORS.Danger
            return
        end

        local equippedNames = {}
        for _, bundleItem in ipairs(bundleItems) do
            local itemId = tonumber(bundleItem.Id or bundleItem.AssetId)
            if itemId then
                local catalogItem = ITEM_BY_ID[itemId]
                if not catalogItem then
                    local bundleAssetType = bundleItem.AssetType or bundleItem.Type or bundleItem.ItemType
                    local bundleKind
                    if not isBundleAccessoryType(bundleAssetType) then
                        bundleKind = "catalog"
                    end
                    catalogItem = registerItem({
                        name = "Bundle_" .. tostring(itemId),
                        label = string.upper(tostring(bundleItem.Name or ("ITEM " .. tostring(itemId)))),
                        id = itemId,
                        accessoryType = getSearchAccessoryType(bundleAssetType),
                        assetType = bundleAssetType,
                        kind = bundleKind,
                        searchCategory = SearchCategory,
                        searchData = {
                            AssetId = itemId,
                            AssetType = bundleAssetType,
                            Name = bundleItem.Name,
                        },
                    })
                    createSelectorOption(catalogItem, #ITEMS)
                end
                if catalogItem and not Enabled[catalogItem.name] then
                    toggleItem(catalogItem.name, true)
                    table.insert(equippedNames, catalogItem.name)
                    task.wait(0.08)
                end
            end
        end

        BundleItemNames[bundleId] = equippedNames
        BundleEnabled[bundleId] = true
        button.Active = true
        button.AutoButtonColor = true
        button.Text = tr("QUITAR CUERPO", "REMOVE BODY")
        button.BackgroundColor3 = COLORS.Success
        SearchStatus.Text = tr("Cuerpo equipado completo", "Complete body equipped")
        SearchStatus.TextColor3 = COLORS.Success
    end)
end

local function getEnumItems(enumType, names)
    local values = {}
    for _, name in ipairs(names) do
        local ok, value = pcall(function()
            return enumType[name]
        end)
        if ok and value then
            table.insert(values, value)
        end
    end
    return values
end

local function getCategoryAssetTypes(category)
    if category == "Head" then
        return getEnumItems(Enum.AvatarAssetType, { "Hat", "DynamicHead" })
    elseif category == "Face" then
        return getEnumItems(Enum.AvatarAssetType, { "FaceAccessory" })
    elseif category == "Neck" then
        return getEnumItems(Enum.AvatarAssetType, { "NeckAccessory" })
    elseif category == "Shoulder" then
        return getEnumItems(Enum.AvatarAssetType, { "ShoulderAccessory" })
    elseif category == "Front" then
        return getEnumItems(Enum.AvatarAssetType, { "FrontAccessory" })
    elseif category == "Back" then
        return getEnumItems(Enum.AvatarAssetType, { "BackAccessory" })
    elseif category == "Waist" then
        return getEnumItems(Enum.AvatarAssetType, { "WaistAccessory" })
    elseif category == "Hair" then
        return getEnumItems(Enum.AvatarAssetType, { "HairAccessory" })
    elseif category == "Eyebrow" then
        return getEnumItems(Enum.AvatarAssetType, { "EyebrowAccessory" })
    elseif category == "Eyelash" then
        return getEnumItems(Enum.AvatarAssetType, { "EyelashAccessory" })
    elseif category == "Bodies" then
        return nil
    elseif category == "Clothing" then
        return getEnumItems(Enum.AvatarAssetType, {
            "TShirt", "TShirtAccessory", "Shirt", "ShirtAccessory",
            "Pants", "PantsAccessory", "Jacket", "JacketAccessory",
            "Sweater", "SweaterAccessory", "Shorts", "ShortsAccessory",
            "DressSkirt", "DressSkirtAccessory", "LeftShoe",
            "RightShoe", "LeftShoeAccessory", "RightShoeAccessory",
        })
    elseif category == "TShirt" then
        return getEnumItems(Enum.AvatarAssetType, { "TShirtAccessory", "ShirtAccessory" })
    elseif category == "ClassicTShirt" then
        return getEnumItems(Enum.AvatarAssetType, { "TShirt" })
    elseif category == "ClassicShirt" then
        return getEnumItems(Enum.AvatarAssetType, { "Shirt" })
    elseif category == "Pants" then
        return getEnumItems(Enum.AvatarAssetType, { "PantsAccessory" })
    elseif category == "ClassicPants" then
        return getEnumItems(Enum.AvatarAssetType, { "Pants" })
    elseif category == "Jacket" then
        return getEnumItems(Enum.AvatarAssetType, { "JacketAccessory" })
    elseif category == "Sweater" then
        return getEnumItems(Enum.AvatarAssetType, { "SweaterAccessory" })
    elseif category == "Shorts" then
        return getEnumItems(Enum.AvatarAssetType, { "ShortsAccessory" })
    elseif category == "DressSkirt" then
        return getEnumItems(Enum.AvatarAssetType, { "DressSkirtAccessory" })
    elseif category == "Shoes" then
        return getEnumItems(Enum.AvatarAssetType, { "LeftShoeAccessory", "RightShoeAccessory" })
    end
    return nil
end

local function getCategoryBundleTypes(category)
    if category == "Bodies" then
        return getEnumItems(Enum.BundleType, { "Body", "Rthro", "Avatar" })
    end
    return nil
end

local function isBundleResult(data)
    local itemType = string.lower(tostring(
        data.ItemType
            or data.ProductType
            or data.Type
            or data.AssetType
            or ""
    ))
    return data.BundleType ~= nil
        or data.BundleId ~= nil
        or data.IsBundle == true
        or string.find(itemType, "bundle", 1, true) ~= nil
end

local function isAccessoryResult(data)
    if isBundleResult(data) then return false end
    local assetType = tonumber(data.AssetType)
    if assetType and table.find({ 8, 41, 42, 43, 44, 45, 46, 47, 76, 77 }, assetType) then
        return true
    end
    local value = string.lower(tostring(data.AssetType or ""))
    return string.find(value, "accessory", 1, true) ~= nil or string.find(value, "hat", 1, true) ~= nil
end

local function addSearchItem(data)
    local assetId = tonumber(data.AssetId or data.BundleId or data.Id)
    if not assetId then return end

    local item = ITEM_BY_ID[assetId]
    local itemName = item and item.name or ("Catalog_" .. tostring(assetId))
    local itemLabel = item and item.label or string.upper(tostring(data.Name or ("ITEM " .. tostring(assetId))))
    local bundleResult = isBundleResult(data)
    local offSale = data.IsOffSale == true or data.IsForSale == false
    local catalogKind
    if not isAccessoryResult(data) then
        catalogKind = "catalog"
    end
    local canUse = bundleResult or (
        item ~= nil
        or isAccessoryResult(data)
        or SearchCategory == "Head"
        or SearchCategory == "Face"
        or SearchCategory == "Neck"
        or SearchCategory == "Shoulder"
        or SearchCategory == "Front"
        or SearchCategory == "Back"
        or SearchCategory == "Waist"
        or SearchCategory == "Hair"
        or SearchCategory == "Eyebrow"
        or SearchCategory == "Eyelash"
        or SearchCategory == "Bodies"
        or SearchCategory == "Clothing"
        or SearchCategory == "TShirt"
        or SearchCategory == "ClassicTShirt"
        or SearchCategory == "ClassicShirt"
        or SearchCategory == "Pants"
        or SearchCategory == "ClassicPants"
        or SearchCategory == "Jacket"
        or SearchCategory == "Sweater"
        or SearchCategory == "Shorts"
        or SearchCategory == "DressSkirt"
        or SearchCategory == "Shoes"
        or SearchCategory == "All"
    )

    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(150, bundleResult and 184 or 154)
    card.LayoutOrder = SearchPageNumber * 100 + #SearchResultsPage:GetChildren()
    card.BackgroundColor3 = COLORS.Card
    card.Parent = SearchResultsPage
    corner(card, 8)
    stroke(card, COLORS.CardHover, 1)

    local thumbnail = Instance.new("ImageLabel")
    thumbnail.Size = UDim2.new(1, -12, 0, 74)
    thumbnail.Position = UDim2.fromOffset(6, 6)
    thumbnail.BackgroundColor3 = COLORS.CardHover
    local thumbnailType = bundleResult and "BundleThumbnail" or "Asset"
    thumbnail.Image = "rbxthumb://type=" .. thumbnailType .. "&id=" .. tostring(assetId) .. "&w=150&h=150"
    thumbnail.ScaleType = Enum.ScaleType.Fit
    thumbnail.Parent = card
    corner(thumbnail, 6)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -12, 0, 30)
    nameLabel.Position = UDim2.fromOffset(6, 84)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = tostring(data.Name or itemLabel)
    nameLabel.TextColor3 = COLORS.Text
    nameLabel.TextSize = 9
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextWrapped = true
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Parent = card

    local idLabel = Instance.new("TextLabel")
    idLabel.Size = UDim2.new(1, -12, 0, 14)
    idLabel.Position = UDim2.fromOffset(6, 112)
    idLabel.BackgroundTransparency = 1
    idLabel.Text = "ID: " .. tostring(assetId) .. (offSale and " • OFFSALE" or "")
    idLabel.TextColor3 = COLORS.Muted
    idLabel.TextSize = 8
    idLabel.Font = Enum.Font.Gotham
    idLabel.TextXAlignment = Enum.TextXAlignment.Left
    idLabel.Parent = card

    local useButton = Instance.new("TextButton")
    useButton.Size = UDim2.new(1, -12, 0, 24)
    useButton.Position = UDim2.new(0, 6, 1, bundleResult and -56 or -30)
    useButton.BackgroundColor3 = COLORS.AccentDark
    useButton.Text = item
        and (Enabled[item.name] and tr("QUITAR", "REMOVE") or tr("USAR", "USE"))
        or (bundleResult
            and (BundleEnabled[assetId] and tr("QUITAR CUERPO", "REMOVE BODY")
                or tr("EQUIPAR CUERPO", "EQUIP BODY"))
            or (canUse and tr("USAR", "USE") or tr("VER", "VIEW")))
    useButton.TextColor3 = COLORS.Text
    useButton.TextSize = 9
    useButton.Font = Enum.Font.GothamBold
    useButton.Parent = card
    corner(useButton, 6)

    useButton.MouseButton1Click:Connect(function()
        if bundleResult then
            equipFullBundle(data, useButton)
            return
        end
        if not canUse then
            SearchStatus.Text = tr(
                "Este resultado se puede consultar, pero no se aplica como accesorio",
                "This result can be viewed but cannot be applied as an accessory"
            )
            SearchStatus.TextColor3 = COLORS.Muted
            return
        end
        local catalogItem = ITEM_BY_ID[assetId]
        if not catalogItem then
            catalogItem = registerItem({
                name = itemName,
                label = itemLabel,
                id = assetId,
                accessoryType = getSearchAccessoryType(data.AssetType),
                assetType = data.AssetType,
                kind = catalogKind,
                searchCategory = SearchCategory,
                searchData = data,
            })
            createSelectorOption(catalogItem, #ITEMS)
        end
        toggleItem(catalogItem.name, not Enabled[catalogItem.name])
        useButton.Text = Enabled[catalogItem.name] and tr("QUITAR", "REMOVE") or tr("USAR", "USE")
        useButton.BackgroundColor3 = Enabled[catalogItem.name] and COLORS.Success or COLORS.AccentDark
        SearchStatus.Text = Enabled[catalogItem.name]
            and (catalogItem.label .. " " .. tr("cargado", "loaded"))
            or (catalogItem.label .. " " .. tr("retirado", "removed"))
        SearchStatus.TextColor3 = Enabled[catalogItem.name] and COLORS.Success or COLORS.Muted
    end)

    if bundleResult then
        local showItemsButton = Instance.new("TextButton")
        showItemsButton.Size = UDim2.new(1, -12, 0, 24)
        showItemsButton.Position = UDim2.new(0, 6, 1, -30)
        showItemsButton.BackgroundColor3 = COLORS.CardHover
        showItemsButton.Text = tr("VER ITEMS", "SHOW ITEMS")
        showItemsButton.TextColor3 = COLORS.Text
        showItemsButton.TextSize = 9
        showItemsButton.Font = Enum.Font.GothamBold
        showItemsButton.Parent = card
        corner(showItemsButton, 6)
        showItemsButton.MouseButton1Click:Connect(function()
            showBundleItems(data)
        end)
    end
end

function renderSearchPage(pageData)
    clearSearchResults()
    local currentPage = pageData or (SearchPages and SearchPages:GetCurrentPage() or {})
    local visibleCount = 0
    for _, data in ipairs(currentPage) do
        if SearchCategory ~= "Bodies" or isBundleResult(data) then
            addSearchItem(data)
            visibleCount += 1
        end
    end
    if visibleCount == 0 then
        SearchStatus.Text = tr("No se encontraron items", "No items found")
        SearchStatus.TextColor3 = COLORS.Muted
    else
        SearchStatus.Text = "Resultados: " .. SearchDescription
        SearchStatus.TextColor3 = COLORS.Muted
    end
    SearchPageInfo.Text = tr("PÁGINA ", "PAGE ") .. tostring(SearchPageNumber)
    SavedHeader.Text = tr("ACCS SAVE", "SAVED ACCESSORIES")
    SearchBackButton.Active = SearchPageNumber > 1
    SearchBackButton.AutoButtonColor = SearchBackButton.Active
    SearchBackButton.TextColor3 = SearchBackButton.Active and COLORS.Text or COLORS.Muted
    SearchNextButton.Active = SearchPages and (
        SearchPageCache[SearchPageNumber + 1] ~= nil
        or not SearchPages.IsFinished
    ) or false
    SearchNextButton.AutoButtonColor = SearchNextButton.Active
    SearchNextButton.TextColor3 = SearchNextButton.Active and COLORS.Text or COLORS.Muted
end

searchCatalog = function(forceSearch)
    local keyword = SearchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creator = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    creator = creator:gsub("^@", "")
    if keyword == "" and creator == "" and not forceSearch then
        ShowingSearchResults = false
        setTab(CurrentTab)
        SearchStatus.Text = tr("Escribe un accesorio o un creador para buscar", "Type an accessory or creator to search")
        SearchStatus.TextColor3 = COLORS.Muted
        return
    end

    SearchBusy = true
    SearchRequest += 1
    table.clear(SearchPageCache)
    local requestId = SearchRequest
    local selectedCategory = SearchCategory
    SearchDescription = keyword ~= "" and keyword or tr("todos los items", "all items")
    if creator ~= "" then
        SearchDescription = SearchDescription .. " • " .. tr("creador: ", "creator: ") .. creator
    end
    SearchDescription = SearchDescription .. " • " .. CategoryLabels[selectedCategory]()
    SearchButton.Text = "..."
    SearchStatus.Text = tr("Buscando en el catálogo...", "Searching catalog...")
    SearchStatus.TextColor3 = COLORS.Muted
    ShowingSearchResults = true
    setTab(CurrentTab)

    task.spawn(function()
        local ok, pages = pcall(function()
            if not CatalogAccessRequested then
                CatalogAccessRequested = true
                pcall(function()
                    S.AvatarEditorService:PromptAllowInventoryReadAccess()
                    S.AvatarEditorService.PromptAllowInventoryReadAccessCompleted:Wait()
                end)
            end
            local parameters = CatalogSearchParams.new()
            if keyword ~= "" then
                parameters.SearchKeyword = keyword
            end
            if creator ~= "" then
                local creatorId = tonumber(creator)
                if creatorId then
                    parameters.CreatorId = creatorId
                else
                    parameters.CreatorName = creator
                end
            end
            parameters.IncludeOffSale = true
            parameters.Limit = 30
            local assetTypes = getCategoryAssetTypes(selectedCategory)
            local bundleTypes = getCategoryBundleTypes(selectedCategory)
            if assetTypes and #assetTypes > 0 then
                parameters.AssetTypes = assetTypes
            end
            if bundleTypes and #bundleTypes > 0 then
                parameters.BundleTypes = bundleTypes
            end
            return S.AvatarEditorService:SearchCatalogAsync(parameters)
        end)

        if requestId ~= SearchRequest then return end
        SearchBusy = false
        SearchButton.Text = tr("BUSCAR", "SEARCH")

        if not ok or not pages then
            SearchStatus.Text = tr("Roblox no permitió realizar la búsqueda", "Roblox did not allow the search")
            SearchStatus.TextColor3 = COLORS.Danger
            return
        end

        SearchPages = pages
        SearchPageNumber = 1
        SearchPageCache[1] = SearchPages:GetCurrentPage()
        renderSearchPage(SearchPageCache[1])
    end)
end

SearchButton.MouseButton1Click:Connect(searchCatalog)
SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then searchCatalog() end
end)
CreatorBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then searchCatalog() end
end)
SearchNextButton.MouseButton1Click:Connect(function()
    if SearchBusy or not SearchPages then return end
    if SearchPageCache[SearchPageNumber + 1] then
        SearchPageNumber += 1
        renderSearchPage(SearchPageCache[SearchPageNumber])
        return
    end
    if SearchPages.IsFinished then return end
    SearchBusy = true
    SearchNextButton.Text = "..."
    task.spawn(function()
        local ok = pcall(function()
            SearchPages:AdvanceToNextPageAsync()
        end)
        SearchBusy = false
        SearchNextButton.Text = tr("SIGUIENTE", "NEXT")
        if ok then
            SearchPageNumber += 1
            SearchPageCache[SearchPageNumber] = SearchPages:GetCurrentPage()
            renderSearchPage(SearchPageCache[SearchPageNumber])
        else
            SearchStatus.Text = tr("No se pudo cargar la siguiente página", "Could not load the next page")
            SearchStatus.TextColor3 = COLORS.Danger
        end
    end)
end)

SearchBackButton.MouseButton1Click:Connect(function()
    if SearchBusy or SearchPageNumber <= 1 then return end
    local previousPage = SearchPageCache[SearchPageNumber - 1]
    if not previousPage then return end
    SearchPageNumber -= 1
    renderSearchPage(previousPage)
end)

header("Ajustes finos", 3)

local ControlTranslations = {
    ESCALA = "SCALE",
    ["POS X"] = "POS X",
    ["POS Y"] = "POS Y",
    ["POS Z"] = "POS Z",
    ["ROT X"] = "ROT X",
    ["ROT Y"] = "ROT Y",
    ["ROT Z"] = "ROT Z",
}
function createControl(labelText, key, step, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 34)
    row.LayoutOrder = order
    row.BackgroundColor3 = COLORS.Card
    row.Parent = EditorPage
    corner(row, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -112, 1, 0)
    label.Position = UDim2.fromOffset(10, 0)
    label.BackgroundTransparency = 1
    label.Text = tr(labelText, ControlTranslations[labelText] or labelText) .. ": 0.00"
    label.TextColor3 = COLORS.Muted
    label.TextSize = 10
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row
    editorLabels[key] = label

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.fromOffset(34, 24)
    minus.Position = UDim2.new(1, -78, 0.5, -12)
    minus.BackgroundColor3 = COLORS.CardHover
    minus.Text = "−"
    minus.TextColor3 = COLORS.Text
    minus.TextSize = 16
    minus.Font = Enum.Font.GothamBold
    minus.Parent = row
    corner(minus, 6)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.fromOffset(34, 24)
    plus.Position = UDim2.new(1, -40, 0.5, -12)
    plus.BackgroundColor3 = COLORS.CardHover
    plus.Text = "+"
    plus.TextColor3 = COLORS.Text
    plus.TextSize = 16
    plus.Font = Enum.Font.GothamBold
    plus.Parent = row
    corner(plus, 6)

    local function change(delta)
        if not SelectedItem then return end
        local values = Transforms[SelectedItem]
        values[key] = round2(values[key] + delta)
        if key == "Scale" then values[key] = math.max(0.05, values[key]) end
        local accessory = deduplicateItem(SelectedItem)
        if accessory then applyTransforms(accessory, SelectedItem) end
        updateEditor()
    end
    minus.MouseButton1Click:Connect(function() change(-step) end)
    plus.MouseButton1Click:Connect(function() change(step) end)
end

createControl("ESCALA", "Scale", 0.1, 4)
createControl("POS X", "PosX", 0.1, 5)
createControl("POS Y", "PosY", 0.1, 6)
createControl("POS Z", "PosZ", 0.1, 7)
createControl("ROT X", "RotX", 15, 8)
createControl("ROT Y", "RotY", 15, 9)
createControl("ROT Z", "RotZ", 15, 10)

local ResetButton = Instance.new("TextButton")
ResetButton.Size = UDim2.new(1, -4, 0, 36)
ResetButton.LayoutOrder = 11
ResetButton.BackgroundColor3 = COLORS.AccentDark
ResetButton.Text = tr("RESTABLECER ACCESORIO SELECCIONADO", "RESET SELECTED ACCESSORY")
ResetButton.TextColor3 = COLORS.Text
ResetButton.TextSize = 10
ResetButton.Font = Enum.Font.GothamBold
ResetButton.Parent = EditorPage
corner(ResetButton, 8)
ResetButton.MouseButton1Click:Connect(function()
    if not SelectedItem then return end
    Transforms[SelectedItem] = {
        Scale = 1, PosX = 0, PosY = 0, PosZ = 0,
        RotX = 0, RotY = 0, RotZ = 0,
    }
    local accessory = deduplicateItem(SelectedItem)
    if accessory then applyTransforms(accessory, SelectedItem) end
    updateEditor()
end)

function refreshLanguage()
    Title.Text = tr("CATÁLOGO  DE  ROPA", "CLOTHING  CATALOG")
    CatalogTab.Text = tr("CATÁLOGO", "CATALOG")
    SavedTab.Text = tr("ACCS SAVE", "SAVED")
    EditorTab.Text = tr("EDITOR 3D", "3D EDITOR")
    AvatarTab.Text = tr("AVATAR", "AVATAR")
    SearchBox.PlaceholderText = tr("BUSCAR ACCESORIOS DE ROBLOX...", "SEARCH ROBLOX ACCESSORIES...")
    CreatorBox.PlaceholderText = tr("CREADOR: USUARIO O GRUPO", "CREATOR: USER OR GROUP")
    SearchButton.Text = SearchBusy and "..." or tr("BUSCAR", "SEARCH")
    SearchBackButton.Text = tr("ATRÁS", "BACK")
    SearchNextButton.Text = SearchBusy and "..." or tr("SIGUIENTE", "NEXT")
    SearchPageInfo.Text = tr("PÁGINA ", "PAGE ") .. tostring(SearchPageNumber)
    SavedHeader.Text = tr("ACCS SAVE", "SAVED ACCESSORIES")
    CatalogEmpty.Text = tr("Busca algo en el catálogo para ver resultados", "Search the catalog to see results")
    SearchStatus.Text = tr("Busca por accesorio o creador", "Search by accessory or creator")
    BundleTitle.Text = tr("ITEMS DEL BUNDLE", "BUNDLE ITEMS")
    ResetButton.Text = tr("RESTABLECER ACCESORIO SELECCIONADO", "RESET SELECTED ACCESSORY")
    AvatarTitle.Text = tr("MI AVATAR", "MY AVATAR")
    AvatarDescription.Text = tr(
        "Quita el avatar actual o guarda tus combinaciones para volver a equiparlas.",
        "Unequip the current avatar or save your outfits to equip them again."
    )
    UnequipAllButton.Text = tr("DESEQUIPAR TODO", "UNEQUIP ALL")
    AvatarStatus.Text = tr("Tus avatares guardados aparecerán aquí.", "Your saved avatars will appear here.")
    PreviewControls.SkinTitle.Text = tr("TONO DE PIEL", "SKIN TONE")
    PreviewLabel.Text = tr("TU PERSONAJE", "YOUR CHARACTER")
    CurrentFitTitle.Text = tr("TU FIT ACTUAL", "CURRENT FIT")
    FitsTitle.Text = tr("AVATARES GUARDADOS", "SAVED AVATARS")
    for _, row in ipairs(FitRows) do
        row.equipButton.Text = tr("EQUIPAR", "EQUIP")
        row.deleteButton.Text = tr("BORRAR", "DELETE")
    end
    renderCurrentFit()
    LanguageButton.Text = Language == "es" and "EN" or "ES"
    updateCategoryButtons()
    updateEditor()
    for itemName in pairs(toggleButtons) do
        refreshToggle(itemName)
    end
    for text, label in pairs(SectionLabels) do
        label.Text = string.upper(tr(text, SectionTranslations[text] or text))
    end
    for _, descendant in ipairs(SearchResultsPage:GetDescendants()) do
        if descendant:IsA("TextButton") then
            local labels = {
                USAR = tr("USAR", "USE"),
                USE = tr("USAR", "USE"),
                QUITAR = tr("QUITAR", "REMOVE"),
                REMOVE = tr("QUITAR", "REMOVE"),
                VER = tr("VER", "VIEW"),
                VIEW = tr("VER", "VIEW"),
                ["VER ITEMS"] = tr("VER ITEMS", "SHOW ITEMS"),
                ["SHOW ITEMS"] = tr("VER ITEMS", "SHOW ITEMS"),
                ["EQUIPAR CUERPO"] = tr("EQUIPAR CUERPO", "EQUIP BODY"),
                ["EQUIP BODY"] = tr("EQUIPAR CUERPO", "EQUIP BODY"),
                ["QUITAR CUERPO"] = tr("QUITAR CUERPO", "REMOVE BODY"),
                ["REMOVE BODY"] = tr("QUITAR CUERPO", "REMOVE BODY"),
            }
            descendant.Text = labels[descendant.Text] or descendant.Text
        end
    end
end

LanguageButton.MouseButton1Click:Connect(function()
    Language = Language == "es" and "en" or "es"
    refreshLanguage()
end)

local Gizmo = Instance.new("Frame")
Gizmo.Size = UDim2.fromOffset(104, 104)
Gizmo.BackgroundTransparency = 1
Gizmo.Visible = false
Gizmo.ZIndex = 50
Gizmo.Parent = ScreenGui

function gizmoButton(text, position, color, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(28, 28)
    button.Position = position
    button.BackgroundColor3 = color
    button.Text = text
    button.TextColor3 = COLORS.Text
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.ZIndex = 51
    button.Parent = Gizmo
    corner(button, 14)
    stroke(button, COLORS.Text, 1)
    button.MouseButton1Click:Connect(callback)
end

function modifySelected(key, amount)
    if not SelectedItem then return end
    Transforms[SelectedItem][key] = round2(Transforms[SelectedItem][key] + amount)
    if key == "Scale" then Transforms[SelectedItem][key] = math.max(0.05, Transforms[SelectedItem][key]) end
    local accessory = deduplicateItem(SelectedItem)
    if accessory then applyTransforms(accessory, SelectedItem) end
    updateEditor()
end

gizmoButton("+", UDim2.fromOffset(38, 0), COLORS.Success, function() modifySelected("Scale", 0.1) end)
gizmoButton("−", UDim2.fromOffset(38, 76), COLORS.Danger, function() modifySelected("Scale", -0.1) end)
gizmoButton("▲", UDim2.fromOffset(38, 26), COLORS.Accent, function() modifySelected("PosY", 0.1) end)
gizmoButton("▼", UDim2.fromOffset(38, 52), COLORS.Accent, function() modifySelected("PosY", -0.1) end)
gizmoButton("◀", UDim2.fromOffset(8, 39), COLORS.Accent, function() modifySelected("PosX", -0.1) end)
gizmoButton("▶", UDim2.fromOffset(68, 39), COLORS.Accent, function() modifySelected("PosX", 0.1) end)
gizmoButton("↻", UDim2.fromOffset(68, 8), Color3.fromRGB(214, 142, 45), function() modifySelected("RotY", 15) end)

S.RunService.RenderStepped:Connect(function()
    updateNetworkBackground()
    updateAvatarPreview()
    if CurrentTab ~= "Editor" or not SelectedItem then
        Gizmo.Visible = false
        return
    end
    local accessory = deduplicateItem(SelectedItem)
    local handle = accessory and getHandle(accessory)
    local camera = workspace.CurrentCamera
    if not handle or not camera then
        Gizmo.Visible = false
        return
    end
    local point, visible = camera:WorldToViewportPoint(handle.Position)
    Gizmo.Visible = visible
    if visible then
        Gizmo.Position = UDim2.fromOffset(point.X - 52, point.Y - 52)
    end
end)

LocalPlayer.CharacterAdded:Connect(handleCharacterAdded)
LocalPlayer.CharacterAdded:Connect(function(character)
    connectPreviewCharacter(character)
    task.delay(3, loadCurrentFit)
end)
if LocalPlayer.Character then
    connectPreviewCharacter(LocalPlayer.Character)
    task.spawn(function() handleCharacterAdded(LocalPlayer.Character) end)
        task.delay(3, loadCurrentFit)
end
