local function updateEditor()
    SelectorButton.Text = tr("ACCESORIO: ", "ACCESSORY: ")
        .. (SelectedItem and ITEM_BY_NAME[SelectedItem].label or tr("NINGUNO", "NONE")) .. "  ▾"
    for key, label in pairs(editorLabels) do
        local value = 0
        if SelectedItem then value = Transforms[SelectedItem][key] end
        local labelName = ({
            Scale = tr("ESCALA", "SCALE"),
            PosX = "POS X",
            PosY = "POS Y",
            PosZ = "POS Z",
            RotX = "ROT X",
            RotY = "ROT Y",
            RotZ = "ROT Z",
        })[key] or key
        label.Text = labelName .. ": " .. string.format("%.2f", value)
    end
end

