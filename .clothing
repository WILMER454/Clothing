local ITEMS = ACCS_SAVE
local ITEM_BY_NAME = {}
local ITEM_BY_ID = {}
for _, item in ipairs(ITEMS) do
    ITEM_BY_NAME[item.name] = item
    ITEM_BY_ID[item.id] = item
end

local Enabled = {}
local Transforms = {}
local SavedFits = {}
SavedFits._OriginalDescription = nil
SavedFits._ActiveFit = nil
local FitNumber = 0
for _, item in ipairs(ITEMS) do
    Enabled[item.name] = false
    Transforms[item.name] = {
        Scale = 1,
        PosX = 0, PosY = 0, PosZ = 0,
        RotX = 0, RotY = 0, RotZ = 0,
    }
end

local function registerItem(item)
    if not item or not item.id or not item.name then return nil end
    if ITEM_BY_ID[item.id] then return ITEM_BY_ID[item.id] end
    table.insert(ITEMS, item)
    ITEM_BY_NAME[item.name] = item
    ITEM_BY_ID[item.id] = item
    Enabled[item.name] = false
    Transforms[item.name] = {
        Scale = 1,
        PosX = 0, PosY = 0, PosZ = 0,
        RotX = 0, RotY = 0, RotZ = 0,
    }
    return item
end

local SelectedItem
local CurrentTab = "Catalog"
local ShowingSearchResults = false
local AssetCache = {}
local BaseWelds = setmetatable({}, { __mode = "k" })
local CharacterConnections = {}
local AccessoryItems = setmetatable({}, { __mode = "k" })
local ApplyTokens = {}
local PendingAccessories = {}
PendingAccessories._Disabled = {}
local ApplySequence = 0
local BundleEnabled = {}
local BundleItemNames = {}

local function disconnectCharacterConnections()
    for _, connection in ipairs(CharacterConnections) do
        connection:Disconnect()
    end
    table.clear(CharacterConnections)
end

local function round2(value)
    return math.floor(value * 100 + 0.5) / 100
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHandle(accessory)
    if not accessory then return nil end
    return accessory:FindFirstChild("Handle") or accessory:FindFirstChildWhichIsA("BasePart", true)
end

local function isAccessoryForItem(child, itemName)
    if not child or not child:IsA("Accessory") then return false end
    if AccessoryItems[child] == itemName then return true end
    if child:GetAttribute("XyroItem") == itemName then return true end
    if child.Name == itemName then return true end
    local item = ITEM_BY_NAME[itemName]
    local assetId = item and item.id
    if child:GetAttribute("XyroAssetId") == assetId then return true end
    if tostring(child:GetAttribute("AssetId")) == tostring(assetId) then return true end
    local handle = getHandle(child)
    if not handle then return false end
    if handle:FindFirstChild("XyroWeld_" .. itemName) then return true end
    if tostring(handle:GetAttribute("AssetId")) == tostring(assetId) then return true end
    if S.accessoryMatchesItemAsset and S.accessoryMatchesItemAsset(child, item) then return true end
    return false
end

local function findItemAccessories(itemName)
    local character = getCharacter()
    local found = {}
    if not character then return found end
    for _, child in ipairs(character:GetChildren()) do
        if isAccessoryForItem(child, itemName) then
            table.insert(found, child)
        end
    end
    return found
end

local function removeItemAccessories(itemName)
    local found = findItemAccessories(itemName)
    for _, accessory in ipairs(found) do
        accessory:Destroy()
    end
    if #found > 0 then return end

    local item = ITEM_BY_NAME[itemName]
    local character = getCharacter()
    local property = item and S.getCatalogProperty and S.getCatalogProperty(item)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not item or not item.accessoryType or not property or not humanoid then return end

    local isEquipped = false
    pcall(function()
        local description = humanoid:GetAppliedDescription()
        local equippedIds = tostring(description[property] or "")
        isEquipped = string.find(
            "," .. equippedIds .. ",",
            "," .. tostring(item.id) .. ",",
            1,
            true
        ) ~= nil
    end)
    if not isEquipped then return end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") and child.AccessoryType == item.accessoryType then
            child:Destroy()
        end
    end
end

local function deduplicateItem(itemName)
    local found = findItemAccessories(itemName)
    if #found < 2 then return found[1] end

    local keep
    for _, accessory in ipairs(found) do
        if not accessory:GetAttribute("XyroFallback") then
            keep = accessory
            break
        end
    end
    keep = keep or found[1]

    for _, accessory in ipairs(found) do
        if accessory ~= keep then
            accessory:Destroy()
        end
    end
    return keep
end

local function tagAccessory(accessory, itemName, isFallback)
    if not accessory then return end
    local item = ITEM_BY_NAME[itemName]
    AccessoryItems[accessory] = itemName
    accessory.Name = itemName
    accessory:SetAttribute("XyroItem", itemName)
    if item then
        accessory:SetAttribute("XyroAssetId", item.id)
    end
    accessory:SetAttribute("XyroFallback", isFallback == true)
end

local function snapshotAccessories(character)
    local snapshot = {}
    if not character then return snapshot end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then
            snapshot[child] = true
        end
    end
    return snapshot
end

local function isCompatibleAccessory(accessory, item)
    if not accessory or not accessory:IsA("Accessory") then return false end
    if not item.accessoryType then return true end
    local accessoryType = accessory.AccessoryType
    return accessoryType == item.accessoryType or accessoryType == Enum.AccessoryType.Unknown
end

local function findNewAccessory(item, snapshot)
    local character = getCharacter()
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory")
            and not snapshot[child]
            and not child:GetAttribute("XyroFallback")
            and not child:GetAttribute("XyroItem")
            and not AccessoryItems[child]
            and isCompatibleAccessory(child, item) then
            return child
        end
    end
    return nil
end

local function findRemote()
    return S.ReplicatedStorage:FindFirstChild("CatalogOnApplyToRealHumanoid", true)
end

local function applyCatalogProperty(property, assetId)
    local remote = findRemote()
    if remote then
        pcall(function()
            remote:FireServer({
                Property = property,
                AssetId = assetId,
            })
        end)
    end
end

S.getCatalogProperty = function(item)
    if not item then return nil end
    local property = item.property
    local supported = {
        GraphicTShirt = true,
        Shirt = true,
        Pants = true,
        TShirtAccessory = true,
        ShirtAccessory = true,
        PantsAccessory = true,
        JacketAccessory = true,
        SweaterAccessory = true,
        ShortsAccessory = true,
        DressSkirtAccessory = true,
        LeftShoeAccessory = true,
        RightShoeAccessory = true,
        Head = true,
        Torso = true,
        LeftArm = true,
        RightArm = true,
        LeftLeg = true,
        RightLeg = true,
        HatAccessory = true,
        HairAccessory = true,
        FaceAccessory = true,
        NeckAccessory = true,
        ShoulderAccessory = true,
        FrontAccessory = true,
        BackAccessory = true,
        WaistAccessory = true,
        EyebrowAccessory = true,
        EyelashAccessory = true,
    }
    if supported[property] then return property end

    local assetType = string.lower(tostring(item.assetType or ""))
    local assetTypeId = tonumber(item.assetType)
    if string.find(assetType, "tshirtaccessory", 1, true) then
        return "TShirtAccessory"
    elseif assetTypeId == 2 or string.find(assetType, "tshirt", 1, true) then
        return "GraphicTShirt"
    elseif assetTypeId == 11 or string.find(assetType, "shirt", 1, true) then
        return string.find(assetType, "accessory", 1, true) and "ShirtAccessory" or "Shirt"
    elseif assetTypeId == 12 or string.find(assetType, "pants", 1, true) then
        return string.find(assetType, "accessory", 1, true) and "PantsAccessory" or "Pants"
    elseif string.find(assetType, "jacket", 1, true) then
        return "JacketAccessory"
    elseif string.find(assetType, "sweater", 1, true) then
        return "SweaterAccessory"
    elseif string.find(assetType, "shorts", 1, true) then
        return "ShortsAccessory"
    elseif string.find(assetType, "dress", 1, true) or string.find(assetType, "skirt", 1, true) then
        return "DressSkirtAccessory"
    elseif string.find(assetType, "leftshoe", 1, true) then
        return "LeftShoeAccessory"
    elseif string.find(assetType, "rightshoe", 1, true) then
        return "RightShoeAccessory"
    elseif assetTypeId == 17 or assetTypeId == 79 then
        return "Head"
    elseif assetTypeId == 31 then
        return "RightLeg"
    elseif string.find(assetType, "head", 1, true) then
        return "Head"
    elseif string.find(assetType, "torso", 1, true) then
        return "Torso"
    elseif string.find(assetType, "leftarm", 1, true) then
        return "LeftArm"
    elseif string.find(assetType, "rightarm", 1, true) then
        return "RightArm"
    elseif string.find(assetType, "leftleg", 1, true) then
        return "LeftLeg"
    elseif string.find(assetType, "rightleg", 1, true) then
        return "RightLeg"
    end
    return nil
end

S.applyLocalClassicClothing = function(item, property, state)
    if not property then return end
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    pcall(function()
        local description = humanoid:GetAppliedDescription()
        if string.find(property, "Accessory", 1, true) then
            local current = tostring(description[property] or "")
            local target = tostring(item.id)
            local ids = {}
            local exists = false
            for id in string.gmatch(current, "%d+") do
                if id == target then
                    exists = true
                    if not state then
                        continue
                    end
                end
                table.insert(ids, id)
            end
            if state and not exists then
                table.insert(ids, target)
            end
            description[property] = table.concat(ids, ",")
            humanoid:ApplyDescription(description)
            return
        end
        local values = {
            GraphicTShirt = 0,
            Shirt = 0,
            Pants = 0,
        }
        for _, knownItem in ipairs(ITEMS) do
            if Enabled[knownItem.name] then
                local knownProperty = S.getCatalogProperty(knownItem)
                if values[knownProperty] ~= nil then
                    values[knownProperty] = knownItem.id
                end
            end
        end
        values[property] = state and item.id or values[property]
        description.GraphicTShirt = values.GraphicTShirt
        description.Shirt = values.Shirt
        description.Pants = values.Pants
        if values[property] == nil then
            description[property] = state and item.id or 0
        end
        humanoid:ApplyDescription(description)
    end)
end

local function applyCatalogAccessoryData(item, assetId)
    local remote = findRemote()
    if remote then
        pcall(function()
            remote:FireServer({
                AccessoryData = {
                    Order = 1,
                    AccessoryType = item.accessoryType or Enum.AccessoryType.Hat,
                    AssetId = assetId,
                },
            })
        end)
    end
end

local function applyGenericCatalogItem(item, state)
    local property = S.getCatalogProperty(item)
    if property then
        applyCatalogProperty(property, state and item.id or 0)
        S.applyLocalClassicClothing(item, property, state)
        return
    end
    local remote = findRemote()
    if not remote then return end
    pcall(function()
        remote:FireServer({
            CatalogData = {
                AssetId = item.id,
                AssetType = item.assetType,
                Category = item.searchCategory,
                Enabled = state,
            },
            AssetId = item.id,
            AssetType = item.assetType,
            Category = item.searchCategory,
            Enabled = state,
        })
    end)
end

local function loadAsset(assetId)
    if AssetCache[assetId] then
        return AssetCache[assetId]:Clone()
    end

    local object
    pcall(function()
        local oldIdentity = getidentity and getidentity() or nil
        if setidentity then setidentity(6) end
        local objects = game:GetObjects("rbxassetid://" .. tostring(assetId))
        if setidentity and oldIdentity then setidentity(oldIdentity) end
        if objects and #objects > 0 then
            local root = objects[1]
            object = root:IsA("Accessory") and root
                or root:FindFirstChildWhichIsA("Accessory", true)
                or root:FindFirstChildWhichIsA("Hat", true)
        end
    end)

    if object then
        AssetCache[assetId] = object
        return object:Clone()
    end
    return nil
end

S.getAccessorySignature = function(accessory)
    local handle = getHandle(accessory)
    if not handle then return nil end
    local mesh = handle:FindFirstChildWhichIsA("SpecialMesh")
    local meshId = ""
    local textureId = ""
    pcall(function() meshId = tostring(handle.MeshId or "") end)
    pcall(function() textureId = tostring(handle.TextureID or "") end)
    return {
        MeshId = meshId,
        TextureId = textureId,
        SpecialMeshId = mesh and tostring(mesh.MeshId or "") or "",
        SpecialTextureId = mesh and tostring(mesh.TextureId or "") or "",
    }
end

S.accessoryMatchesItemAsset = function(accessory, item)
    if not item or not item.id then return false end
    local source = loadAsset(item.id)
    if not source then return false end
    local currentSignature = S.getAccessorySignature(accessory)
    local sourceSignature = S.getAccessorySignature(source)
    if not currentSignature or not sourceSignature then return false end
    if sourceSignature.MeshId ~= "" and currentSignature.MeshId == sourceSignature.MeshId then
        return true
    end
    if sourceSignature.SpecialMeshId ~= "" and currentSignature.SpecialMeshId == sourceSignature.SpecialMeshId then
        return true
    end
    if sourceSignature.TextureId ~= "" and currentSignature.TextureId == sourceSignature.TextureId
        and sourceSignature.SpecialTextureId ~= ""
        and currentSignature.SpecialTextureId == sourceSignature.SpecialTextureId then
        return true
    end
    return false
end

S.removeCatalogInstances = function(item)
    local character = getCharacter()
    if not character or not item then return end
    local property = S.getCatalogProperty(item)
    local className
    if property == "GraphicTShirt" then
        className = "ShirtGraphic"
    elseif property == "Shirt" then
        className = "Shirt"
    elseif property == "Pants" then
        className = "Pants"
    end
    if className then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA(className) then
                child:Destroy()
            end
        end
    end
end

local function getBodyAttachment(character, handleAttachment)
    if not character or not handleAttachment then return nil end
    return character:FindFirstChild(handleAttachment.Name, true)
end

local function makeFallbackWeld(accessory, bodyPart, itemName)
    local handle = getHandle(accessory)
    if not handle or not bodyPart then return nil end

    for _, child in ipairs(handle:GetChildren()) do
        if child:IsA("Weld") or child:IsA("WeldConstraint") then
            child:Destroy()
        end
    end

    local handleAttachment = handle:FindFirstChildWhichIsA("Attachment")
    local bodyAttachment = getBodyAttachment(bodyPart.Parent, handleAttachment)
    local weld = Instance.new("Weld")
    weld.Name = "XyroWeld_" .. itemName
    weld.Part0 = handle
    weld.Part1 = bodyPart
    weld.C0 = handleAttachment and handleAttachment.CFrame or CFrame.new()
    weld.C1 = bodyAttachment and bodyAttachment.CFrame or CFrame.new()
    weld.Parent = handle
    return weld
end

local function findWeld(accessory, itemName)
    local handle = getHandle(accessory)
    if not handle then return nil end
    local named = handle:FindFirstChild("XyroWeld_" .. itemName)
    if named and named:IsA("Weld") then return named end
    for _, child in ipairs(handle:GetChildren()) do
        if child:IsA("Weld") or child:IsA("Motor6D") then
            return child
        end
    end
    return nil
end

local function applyTransforms(accessory, itemName)
    if not accessory then return end
    local transform = Transforms[itemName]
    if not transform then return end
    local handle = getHandle(accessory)
    if not handle then return end

    accessory:SetAttribute("XyroItem", itemName)
    local weld = findWeld(accessory, itemName)
    if weld then
        if not BaseWelds[weld] then
            BaseWelds[weld] = { C0 = weld.C0, C1 = weld.C1 }
        end
        local base = BaseWelds[weld]
        local offset = CFrame.new(transform.PosX, transform.PosY, transform.PosZ)
            * CFrame.Angles(
                math.rad(transform.RotX),
                math.rad(transform.RotY),
                math.rad(transform.RotZ)
            )
        weld.C0 = base.C0 * offset
        weld.C1 = base.C1
    end

    local originalSize = handle:GetAttribute("XyroOriginalSize")
    if not originalSize then
        originalSize = handle.Size
        handle:SetAttribute("XyroOriginalSize", originalSize)
    end
    handle.Size = originalSize * math.max(0.05, transform.Scale)

    local mesh = handle:FindFirstChildWhichIsA("SpecialMesh")
    if mesh then
        local originalMeshScale = mesh:GetAttribute("XyroOriginalScale")
        if not originalMeshScale then
            originalMeshScale = mesh.Scale
            mesh:SetAttribute("XyroOriginalScale", originalMeshScale)
        end
        mesh.Scale = originalMeshScale * math.max(0.05, transform.Scale)
    end
end

local function attachFallback(item)
    local character = getCharacter()
    if not character then return nil end
    local accessory = loadAsset(item.id)
    if not accessory then return nil end

    tagAccessory(accessory, item.name, true)

    local handle = getHandle(accessory)
    if not handle then
        accessory:Destroy()
        return nil
    end
    handle.CanCollide = false
    handle.Massless = true
    handle.Anchored = false
    handle.Transparency = 0

    local bodyPart
    if item.name == "Korblox" then
        bodyPart = character:FindFirstChild("RightFoot")
            or character:FindFirstChild("RightLowerLeg")
            or character:FindFirstChild("Right Leg")
    else
        bodyPart = character:FindFirstChild("Head")
    end
    if not bodyPart then
        accessory:Destroy()
        return nil
    end

    accessory.Parent = character
    makeFallbackWeld(accessory, bodyPart, item.name)
    applyTransforms(accessory, item.name)
    return accessory
end

local function restoreBodyPart(item, visible)
    local character = getCharacter()
    if not character then return end
    if item.property == "Head" then
        local head = character:FindFirstChild("Head")
        if head then
            head.Transparency = visible and 0 or 1
            local face = head:FindFirstChild("face")
            if face then face.Transparency = visible and 0 or 1 end
        end
    elseif item.property == "RightLeg" then
        for _, partName in ipairs({ "RightLowerLeg", "RightUpperLeg", "RightFoot", "Right Leg" }) do
            local part = character:FindFirstChild(partName)
            if part then part.Transparency = visible and 0 or 1 end
        end
    end
end

local function toggleItem(itemName, state)
    local item = ITEM_BY_NAME[itemName]
    if not item then return end
    ApplyTokens[itemName] = (ApplyTokens[itemName] or 0) + 1
    local token = ApplyTokens[itemName]
    ApplySequence = ApplySequence + 1
    PendingAccessories[itemName] = nil
    Enabled[itemName] = state
    PendingAccessories._Disabled[itemName] = not state
    removeItemAccessories(itemName)
    S.removeCatalogInstances(item)
    local descriptionProperty = S.getCatalogProperty(item)
    if item.kind ~= "catalog" and descriptionProperty then
        S.applyLocalClassicClothing(item, descriptionProperty, state)
    end

    if not state then
        if SelectedItem == itemName then SelectedItem = nil end
        if item.kind == "catalog" then
            applyGenericCatalogItem(item, false)
        elseif item.kind == "property" then
            applyCatalogProperty(item.property, 0)
            restoreBodyPart(item, true)
        else
            applyCatalogAccessoryData(item, 0)
        end
        return
    end

    if item.kind == "catalog" then
        applyGenericCatalogItem(item, true)
        return
    end

    if item.kind == "property" then
        applyCatalogProperty(item.property, item.id)
        restoreBodyPart(item, false)
        if itemName == "Korblox" then
            attachFallback(item)
        end
        return
    end

    local character = getCharacter()
    local snapshot = snapshotAccessories(character)
    PendingAccessories[itemName] = {
        token = token,
        snapshot = snapshot,
        order = ApplySequence,
    }
    applyCatalogAccessoryData(item, item.id)
    task.delay(1.25, function()
        if not Enabled[itemName] or ApplyTokens[itemName] ~= token then return end
        local accessory = deduplicateItem(itemName)
        if not accessory then
            accessory = findNewAccessory(item, snapshot)
            if accessory then
                tagAccessory(accessory, itemName, false)
            end
        end
        if not accessory then
            accessory = attachFallback(item)
        end
        if accessory then
            deduplicateItem(itemName)
            applyTransforms(accessory, itemName)
        end
        task.delay(5, function()
            local pending = PendingAccessories[itemName]
            if pending and pending.token == token then
                PendingAccessories[itemName] = nil
            end
        end)
    end)
end

local function handleCharacterAdded(character)
    disconnectCharacterConnections()
    table.insert(CharacterConnections, character.ChildAdded:Connect(function(child)
        if not child:IsA("Accessory") then return end
        task.defer(function()
            local matchedItem
            local matchedOrder
            for _, item in ipairs(ITEMS) do
                local pending = PendingAccessories[item.name]
                local isNewRemote = Enabled[item.name]
                    and pending
                    and pending.token == ApplyTokens[item.name]
                    and not pending.snapshot[child]
                    and not child:GetAttribute("XyroFallback")
                    and not child:GetAttribute("XyroItem")
                    and not AccessoryItems[child]
                    and isCompatibleAccessory(child, item)
                if isNewRemote and (not matchedOrder or pending.order < matchedOrder) then
                    matchedItem = item
                    matchedOrder = pending.order
                end
            end
            if matchedItem then
                tagAccessory(child, matchedItem.name, false)
            end
            for _, item in ipairs(ITEMS) do
                if Enabled[item.name] and isAccessoryForItem(child, item.name) then
                    local current = deduplicateItem(item.name)
                    if current then applyTransforms(current, item.name) end
                end
            end
        end)
    end))

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    task.wait(2.5)
    local firstCharacter = not SavedFits._OriginalDescription
    if firstCharacter then
        pcall(function()
            local description = humanoid:GetAppliedDescription()
            SavedFits._OriginalDescription = description:Clone()
        end)
    end

    if not SavedFits._ActiveFit then
        if not firstCharacter and SavedFits._OriginalDescription then
            pcall(function()
                humanoid:ApplyDescription(SavedFits._OriginalDescription)
            end)
        end
        for _, item in ipairs(ITEMS) do
            Enabled[item.name] = false
            PendingAccessories._Disabled[item.name] = nil
        end
        return
    end

    for _, item in ipairs(ITEMS) do
        local savedItem = SavedFits._ActiveFit.items[item.name]
        if savedItem then
            if savedItem.transform then
                Transforms[item.name] = {
                    Scale = savedItem.transform.Scale,
                    PosX = savedItem.transform.PosX,
                    PosY = savedItem.transform.PosY,
                    PosZ = savedItem.transform.PosZ,
                    RotX = savedItem.transform.RotX,
                    RotY = savedItem.transform.RotY,
                    RotZ = savedItem.transform.RotZ,
                }
            end
            toggleItem(item.name, true)
        else
            toggleItem(item.name, false)
        end
        task.wait(0.08)
    end
end

