local ResizeState = {
    Active = false,
    DragInput = nil,
    StartPosition = nil,
    StartWidth = 0,
    StartHeight = 0,
}

ResizeButton.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    ResizeState.Active = true
    ResizeState.StartPosition = input.Position
    ResizeState.StartWidth = PanelWidth
    ResizeState.StartHeight = PanelHeight
    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            ResizeState.Active = false
            ResizeState.DragInput = nil
        end
    end)
end)

ResizeButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        ResizeState.DragInput = input
    end
end)

S.UserInputService.InputChanged:Connect(function(input)
    if not ResizeState.Active
        or input ~= ResizeState.DragInput
        or not ResizeState.StartPosition then
        return
    end
    local camera = workspace.CurrentCamera
    local maxWidth = camera and math.max(340, camera.ViewportSize.X - 24) or 1400
    local maxHeight = camera and math.max(540, camera.ViewportSize.Y - 24) or 1000
    local delta = input.Position - ResizeState.StartPosition
    PanelWidth = math.clamp(ResizeState.StartWidth + delta.X, 340, maxWidth)
    PanelHeight = math.clamp(ResizeState.StartHeight + delta.Y, 540, maxHeight)
    Panel.Size = UDim2.fromOffset(PanelWidth, PanelHeight)
end)

local Network = {
    Nodes = {},
    Lines = {},
    ConnectionDistance = 125,
    NodeCount = 24,
    Canvas = Instance.new("Frame"),
}
Network.Canvas.Name = "NetworkBackground"
Network.Canvas.Size = UDim2.fromScale(1, 1)
Network.Canvas.BackgroundColor3 = COLORS.Background
Network.Canvas.BackgroundTransparency = 0.08
Network.Canvas.BorderSizePixel = 0
Network.Canvas.ClipsDescendants = true
Network.Canvas.ZIndex = 1
Network.Canvas.Parent = Panel

local function drawNetworkLine(lineFrame, pointA, pointB)
    local distance = (pointB - pointA).Magnitude
    local angle = math.atan2(pointB.Y - pointA.Y, pointB.X - pointA.X)
    local strength = math.clamp(1 - distance / Network.ConnectionDistance, 0, 1)
    lineFrame.Size = UDim2.fromOffset(distance, 1)
    lineFrame.Position = UDim2.fromOffset(pointA.X, pointA.Y)
    lineFrame.Rotation = math.deg(angle)
    lineFrame.BackgroundTransparency = 1 - strength * 0.52
end

for index = 1, Network.NodeCount do
    local node = {
        x = math.random(20, math.max(20, PanelWidth - 20)),
        y = math.random(70, math.max(70, PanelHeight - 20)),
        vx = (math.random() - 0.5) * 0.7,
        vy = (math.random() - 0.5) * 0.7,
        pulse = math.random() * math.pi * 2,
        gui = Instance.new("Frame"),
    }
    node.gui.Name = "NetworkNode" .. tostring(index)
    node.gui.Size = UDim2.fromOffset(3, 3)
    node.gui.AnchorPoint = Vector2.new(0.5, 0.5)
    node.gui.BackgroundColor3 = COLORS.Accent
    node.gui.BackgroundTransparency = 0.08
    node.gui.BorderSizePixel = 0
    node.gui.ZIndex = 1
    node.gui.Parent = Network.Canvas
    corner(node.gui, 3)
    table.insert(Network.Nodes, node)
end

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(math.random(2, 4))
        if not ScreenGui.Parent then break end
        local wave = Instance.new("Frame")
        wave.Name = "NetworkWave"
        wave.AnchorPoint = Vector2.new(0.5, 0.5)
        wave.Position = UDim2.fromOffset(
            math.random(40, math.max(40, PanelWidth - 40)),
            math.random(70, math.max(70, PanelHeight - 40))
        )
        wave.Size = UDim2.fromOffset(0, 0)
        wave.BackgroundTransparency = 1
        wave.ZIndex = 1
        wave.Parent = Network.Canvas
        corner(wave, 100)
        local waveStroke = stroke(wave, COLORS.Accent, 1)
        waveStroke.Transparency = 0.35
        local tweenInfo = TweenInfo.new(2.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local sizeTween = S.TweenService:Create(
            wave,
            tweenInfo,
            { Size = UDim2.fromOffset(math.random(100, 220), math.random(100, 220)) }
        )
        local fadeTween = S.TweenService:Create(waveStroke, tweenInfo, { Transparency = 1 })
        sizeTween:Play()
        fadeTween:Play()
        fadeTween.Completed:Connect(function()
            if wave.Parent then wave:Destroy() end
        end)
    end
end)

local function updateNetworkBackground()
    if not Panel.Visible then return end
    local width = Network.Canvas.AbsoluteSize.X
    local height = Network.Canvas.AbsoluteSize.Y
    if width <= 0 or height <= 0 then return end

    for _, node in ipairs(Network.Nodes) do
        node.x += node.vx
        node.y += node.vy
        node.pulse += 0.055
        if node.x <= 8 or node.x >= width - 8 then
            node.vx = -node.vx
            node.x = math.clamp(node.x, 8, width - 8)
        end
        if node.y <= 55 or node.y >= height - 8 then
            node.vy = -node.vy
            node.y = math.clamp(node.y, 55, height - 8)
        end
        node.gui.Position = UDim2.fromOffset(node.x, node.y)
        local pulse = (math.sin(node.pulse) + 1) * 0.5
        local nodeSize = 3 + pulse * 2
        node.gui.Size = UDim2.fromOffset(nodeSize, nodeSize)
        node.gui.BackgroundTransparency = 0.08 + pulse * 0.24
    end

    for _, line in ipairs(Network.Lines) do
        line.Visible = false
    end

    local lineIndex = 0
    for first = 1, #Network.Nodes do
        for second = first + 1, #Network.Nodes do
            local pointA = Vector2.new(Network.Nodes[first].x, Network.Nodes[first].y)
            local pointB = Vector2.new(Network.Nodes[second].x, Network.Nodes[second].y)
            if (pointB - pointA).Magnitude < Network.ConnectionDistance then
                lineIndex += 1
                local line = Network.Lines[lineIndex]
                if not line then
                    line = Instance.new("Frame")
                    line.Name = "NetworkLine" .. tostring(lineIndex)
                    line.AnchorPoint = Vector2.new(0, 0.5)
                    line.BackgroundColor3 = COLORS.Accent
                    line.BorderSizePixel = 0
                    line.ZIndex = 1
                    line.Parent = Network.Canvas
                    table.insert(Network.Lines, line)
                end
                line.Visible = true
                drawNetworkLine(line, pointA, pointB)
            end
        end
    end
end

