local AvatarPage

local function setTab(tab)
    CurrentTab = tab
    local catalog = tab == "Catalog"
    local saved = tab == "Saved"
    CatalogPage.Visible = catalog and not ShowingSearchResults
    SearchResultsPage.Visible = catalog and ShowingSearchResults
    SavedPage.Visible = saved
    SearchPanel.Visible = catalog
    SearchNavigation.Visible = catalog and ShowingSearchResults
    EditorPage.Visible = tab == "Editor"
    AvatarPage.Visible = tab == "Avatar"
    if not catalog then BundleModal.Visible = false end
    CatalogTab.BackgroundColor3 = catalog and COLORS.Accent or COLORS.Card
    CatalogTab.TextColor3 = catalog and COLORS.Text or COLORS.Muted
    SavedTab.BackgroundColor3 = saved and COLORS.Accent or COLORS.Card
    SavedTab.TextColor3 = saved and COLORS.Text or COLORS.Muted
    EditorTab.BackgroundColor3 = tab == "Editor" and COLORS.Accent or COLORS.Card
    EditorTab.TextColor3 = tab == "Editor" and COLORS.Text or COLORS.Muted
    AvatarTab.BackgroundColor3 = tab == "Avatar" and COLORS.Accent or COLORS.Card
    AvatarTab.TextColor3 = tab == "Avatar" and COLORS.Text or COLORS.Muted
end
CatalogTab.MouseButton1Click:Connect(function() setTab("Catalog") end)
SavedTab.MouseButton1Click:Connect(function() setTab("Saved") end)
EditorTab.MouseButton1Click:Connect(function() setTab("Editor") end)
AvatarTab.MouseButton1Click:Connect(function() setTab("Avatar") end)
Ball.MouseButton1Click:Connect(function() Panel.Visible = not Panel.Visible end)
Minimize.MouseButton1Click:Connect(function() Panel.Visible = false end)
Close.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

local toggleButtons = {}
local createSelectorOption
local function refreshToggle(itemName)
    local button = toggleButtons[itemName]
    if not button then return end
    local on = Enabled[itemName]
    button.BackgroundColor3 = on and COLORS.AccentDark or COLORS.Card
    button.TextColor3 = on and COLORS.Text or COLORS.Muted
    button.Text = (on and "●  " or "○  ") .. ITEM_BY_NAME[itemName].label
end

local function createCatalogButton(item, order)
    if toggleButtons[item.name] then return toggleButtons[item.name] end
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 38)
    button.LayoutOrder = order or (#ITEMS + 1)
    button.BackgroundColor3 = COLORS.Card
    button.TextColor3 = COLORS.Muted
    button.Text = "○  " .. item.label
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = SavedPage
    corner(button, 8)
    stroke(button, COLORS.CardHover, 1)
    toggleButtons[item.name] = button
    button.MouseButton1Click:Connect(function()
        toggleItem(item.name, not Enabled[item.name])
        refreshToggle(item.name)
        Status.Text = Enabled[item.name]
            and (item.label .. " " .. tr("cargado", "loaded"))
            or (item.label .. " " .. tr("retirado", "removed"))
        Status.TextColor3 = Enabled[item.name] and COLORS.Success or COLORS.Muted
    end)
    return button
end

for index, item in ipairs(ITEMS) do
    createCatalogButton(item, index)
end

