for index, color in ipairs({
    Color3.fromRGB(255, 224, 189),
    Color3.fromRGB(255, 205, 148),
    Color3.fromRGB(239, 194, 143),
    Color3.fromRGB(224, 172, 118),
    Color3.fromRGB(198, 134, 88),
    Color3.fromRGB(166, 101, 62),
    Color3.fromRGB(128, 75, 45),
    Color3.fromRGB(92, 52, 32),
    Color3.fromRGB(64, 38, 25),
}) do
    local swatch = Instance.new("TextButton")
    swatch.Size = UDim2.fromOffset(24, 24)
    swatch.Position = UDim2.fromOffset(7 + (index - 1) * 29, 27)
    swatch.BackgroundColor3 = color
    swatch.Text = ""
    swatch.AutoButtonColor = true
    swatch.Parent = PreviewControls.SkinPanel
    corner(swatch, 12)
    stroke(swatch, COLORS.CardHover, 1)
    swatch.MouseButton1Click:Connect(function()
        local character = getCharacter()
        local bodyColors = character and character:FindFirstChildOfClass("BodyColors")
        if bodyColors then
            bodyColors.HeadColor3 = color
            bodyColors.LeftArmColor3 = color
            bodyColors.RightArmColor3 = color
            bodyColors.LeftLegColor3 = color
            bodyColors.RightLegColor3 = color
            bodyColors.TorsoColor3 = color
        end
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                local description = humanoid:GetAppliedDescription()
                local brickColor = BrickColor.new(color)
                description.HeadColor = brickColor
                description.LeftArmColor = brickColor
                description.RightArmColor = brickColor
                description.LeftLegColor = brickColor
                description.RightLegColor = brickColor
                description.TorsoColor = brickColor
                humanoid:ApplyDescription(description)
            end)
        end
        PreviewDirty = true
    end)
end

