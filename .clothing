local function corner(parent, radius)
    local value = Instance.new("UICorner")
    value.CornerRadius = UDim.new(0, radius or 8)
    value.Parent = parent
    return value
end

local function stroke(parent, color, thickness)
    local value = Instance.new("UIStroke")
    value.Color = color
    value.Thickness = thickness or 1
    value.Transparency = 0.15
    value.Parent = parent
    return value
end

local function makeDraggable(object, excludedObject, excludedObject2)
    local dragging, dragStart, startPosition, dragInput
    object.InputBegan:Connect(function(input)
        local insideFirst = excludedObject
            and input.Position.X >= excludedObject.AbsolutePosition.X
            and input.Position.X <= excludedObject.AbsolutePosition.X + excludedObject.AbsoluteSize.X
            and input.Position.Y >= excludedObject.AbsolutePosition.Y
            and input.Position.Y <= excludedObject.AbsolutePosition.Y + excludedObject.AbsoluteSize.Y
        local insideSecond = excludedObject2
            and input.Position.X >= excludedObject2.AbsolutePosition.X
            and input.Position.X <= excludedObject2.AbsolutePosition.X + excludedObject2.AbsoluteSize.X
            and input.Position.Y >= excludedObject2.AbsolutePosition.Y
            and input.Position.Y <= excludedObject2.AbsolutePosition.Y + excludedObject2.AbsoluteSize.Y
        if insideFirst or insideSecond then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = object.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    object.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    S.UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

