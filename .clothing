CategoryLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    CategoryFrame.CanvasSize = UDim2.fromOffset(CategoryLayout.AbsoluteContentSize.X + 8, 0)
end)
for index, category in ipairs(CategoryOrder) do
    local categoryButton = Instance.new("TextButton")
    local wideCategory = category == "TShirt"
        or category == "ClassicTShirt"
        or category == "ClassicShirt"
        or category == "Pants"
        or category == "ClassicPants"
        or category == "DressSkirt"
    categoryButton.Size = UDim2.fromOffset(wideCategory and 112 or 82, 24)
    categoryButton.BackgroundColor3 = category == SearchCategory and COLORS.AccentDark or COLORS.Card
    categoryButton.Text = CategoryLabels[category]()
    categoryButton.TextColor3 = category == SearchCategory and COLORS.Text or COLORS.Muted
    categoryButton.TextSize = 8
    categoryButton.Font = Enum.Font.GothamBold
    categoryButton.Parent = CategoryFrame
    corner(categoryButton, 6)
    CategoryButtons[category] = categoryButton
    categoryButton.MouseButton1Click:Connect(function()
        SearchCategory = category
        updateCategoryButtons()
        if searchCatalog then
            searchCatalog(true)
        end
    end)
end

updateCategoryButtons = function()
    for name, button in pairs(CategoryButtons) do
        local selected = name == SearchCategory
        button.BackgroundColor3 = selected and COLORS.AccentDark or COLORS.Card
        button.TextColor3 = selected and COLORS.Text or COLORS.Muted
        button.Text = CategoryLabels[name]()
    end
end
